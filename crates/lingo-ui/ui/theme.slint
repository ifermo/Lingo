export global Theme {
    in-out property <bool> dark: true;

    out property <string> font-family: "SF Pro Text";

    out property <color> bg: #192124;
    out property <color> surface: #1E282D;
    out property <color> surface-alt: #233037;
    out property <color> sidebar: #15171A;
    out property <color> sidebar-text: #9FB5CB;
    out property <color> sidebar-muted: #6C8DB0;
    out property <color> nav-active: #C4DFFB;
    out property <color> nav-hover: #FFFFFF.with-alpha(0.035);

    out property <color> text: #9FB5CB;
    out property <color> muted: #6C8DB0;
    out property <color> subtle: #4F6981;
    out property <color> border: #2B3A43;
    out property <color> field: #151D20;
    out property <color> track: #2B3A43;

    out property <color> accent: #128EFF;
    out property <color> accent-hover: #3A9FFF;
    out property <color> accent-text: #063454;
    out property <color> success: #08D447;
    out property <color> warning: #F79009;
    out property <color> danger: #F04438;

    out property <color> overlay: #000000.with-alpha(0.62);

    out property <length> space-xs: 4px;
    out property <length> space-s: 8px;
    out property <length> space-m: 12px;
    out property <length> space-l: 16px;
    out property <length> space-xl: 26px;
    out property <length> space-xxl: 32px;

    out property <length> radius-s: 6px;
    out property <length> radius-m: 8px;
    out property <length> radius-l: 14px;

    out property <length> title-size: 14px;
    out property <length> heading-size: 16px;
    out property <length> body-size: 13px;
    out property <length> small-size: 11px;
}
